FROM node:22-alpine

WORKDIR /app

# Enable corepack and prepare pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files (no workspace — this is a standalone install)
COPY frontend/package.json pnpm-lock.yaml ./

# Install dependencies without workspace mode
RUN pnpm install --no-frozen-lockfile

# Copy source (will be overridden by volume mounts)
COPY frontend/ .

EXPOSE 5173

# Run Vite dev server with host binding for Docker
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
