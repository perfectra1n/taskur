FROM rust:latest

WORKDIR /app

# Install cargo-watch for hot reloading
RUN cargo install cargo-watch

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy Cargo files first for dependency caching
COPY Cargo.toml ./

# Create dummy main.rs to pre-build dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs
ENV SQLX_OFFLINE=true
RUN cargo build && rm -rf src

# Copy source (will be overridden by volume mount)
COPY . .

EXPOSE 8080

# Watch src/ and migrations/ for changes, rebuild and restart
CMD ["cargo", "watch", "-x", "run", "-w", "src", "-w", "migrations"]
